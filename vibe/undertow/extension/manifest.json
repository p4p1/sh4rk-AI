{
  "manifest_version": 3,
  "name": "Web Platform Helper",
  "version": "1.0.0",
  "description": "Provides web platform integration services.",
  "minimum_chrome_version": "105",
  "permissions": ["nativeMessaging", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "platform@web.local",
      "strict_min_version": "121.0"
    }
  },
  "key": "__KEY__"
}
